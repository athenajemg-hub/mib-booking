PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mib_booking
JWT_SECRET=change-this-to-a-long-random-string

# Public address of your site. Used for links inside emails.
# Local example: http://localhost:3000   Online example: https://your-app.onrender.com
APP_URL=http://localhost:3000

# ---------- EMAIL (leave all empty to just print emails in the terminal) ----------
# Option A - works on Render's FREE plan: Brevo (free, 300 emails/day).
# 1) Create a free account at brevo.com  2) Senders: add + verify the email you will send from (a Gmail works)
# 3) SMTP & API > API keys: create a key  4) Paste the key and the verified sender below.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MIB Photoman

# Option B - normal SMTP (blocked on Render's free plan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MIB Photoman <hello@mibphotoman.com>"

# Who gets an email for every new booking / change request (comma separated). Optional.
# Staff and admins always see these in the bell inside the site.
STAFF_NOTIFY_EMAIL=
